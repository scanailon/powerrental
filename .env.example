# URL pública del sitio (sitemap, robots, metadata)
NEXT_PUBLIC_SITE_URL=https://powerrental.cl

# Panel admin
# Hash de la contraseña: genéralo con `npm run gen-admin-hash -- "tu-contraseña"` (formato salt:hash en hex)
PR_ADMIN_HASH=
# Secreto para firmar la cookie de sesión (mín. 32 caracteres)
PR_JWT_SECRET=

# Opcional: carpetas de datos (por defecto ./data y ./data/uploads)
# PR_DATA_DIR=
# PR_UPLOADS_DIR=

# Formulario de contacto (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=info@powerrental.cl

# Google Analytics (opcional)
NEXT_PUBLIC_GA_ID=G-9XH76B5W7J
